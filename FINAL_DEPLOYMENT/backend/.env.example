# =============================================================================
#  BACKEND ENVIRONMENT — copy to `backend/.env` and fill in real values.
#  NEVER commit the real .env file. NEVER put any of these in the frontend.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# Set to "false" only if the app is NOT behind a reverse proxy / CDN.
# Leave unset (default) on Railway, Fly.io, Netlify or any platform proxy so
# rate limiting sees the real client IP instead of the proxy IP.
# TRUST_PROXY=

# ── Database — Turso / libSQL (REQUIRED, server exits without it) ────────────
# Create a free database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Must be at least 32 characters or the server refuses to start.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Password for the seeded `superadmin` account in company code SYSTEM.
# Only used the first time the database is created. Must be 10+ chars with an
# uppercase, lowercase, number and symbol. Change it at first login.
SUPER_ADMIN_INITIAL_PASSWORD=

# ── CORS (REQUIRED in production) ────────────────────────────────────────────
# Comma-separated list of exact frontend origins, no trailing slash.
# Include the mobile field-collection site if it is on its own domain.
# Any https://<name>.netlify.app origin is additionally allowed by default.
# Falls back to http://localhost:3000 when empty.
CORS_ORIGIN=https://your-site.netlify.app,https://your-mobile-site.netlify.app

# ── Public base URL ──────────────────────────────────────────────────────────
# Used to build field-collection links. On Railway, RAILWAY_PUBLIC_DOMAIN is
# injected automatically and takes priority; set PUBLIC_URL elsewhere.
# PUBLIC_URL=https://your-backend.example.com

# ── Email — option 1: Resend SMTP bridge (preferred) ─────────────────────────
# Leave blank to disable outbound email; /api/admin/email/* then return 503.
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Mulyanka

# ── Email — option 2: custom SMTP (used only if RESEND_API_KEY is empty) ─────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
