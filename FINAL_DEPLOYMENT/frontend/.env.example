# =============================================================================
#  FRONTEND ENVIRONMENT — copy to `frontend/.env` (or set in Netlify UI).
#
#  WARNING: every VITE_* value is compiled into the public JavaScript bundle
#  and is readable by anyone. Never put a secret, token, password or database
#  credential here.
# =============================================================================

# Base URL of the backend API, with NO trailing slash and NO /api suffix.
# The app appends "/api" itself.
#
#   Local development : leave EMPTY — Vite proxies /api to localhost:3001.
#   Production        : https://your-backend.up.railway.app
VITE_API_URL=
