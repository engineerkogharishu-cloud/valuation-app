# =============================================================================
#  This project uses TWO separate environment files. This root file is a map
#  only — do not put real values here.
#
#    backend/.env   ← copy from backend/.env.example   (server secrets)
#    frontend/.env  ← copy from frontend/.env.example  (public build values)
#
#  See README.md → "Environment setup".
# =============================================================================

# --- backend/.env (server-side only, never exposed to the browser) ---
# NODE_ENV=production
# PORT=3001
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# JWT_SECRET=
# SUPER_ADMIN_INITIAL_PASSWORD=
# CORS_ORIGIN=
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# --- frontend/.env (public, compiled into the bundle) ---
# VITE_API_URL=
